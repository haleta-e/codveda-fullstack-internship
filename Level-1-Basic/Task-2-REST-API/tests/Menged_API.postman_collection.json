      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Verifies that the Express server is up and responsive."
      }
    },
    {
      "name": "02 - Get All Opportunities",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["api", "opportunities"]
        },
        "description": "Fetches all opportunities ordered by created_at DESC."
      }
    },
    {
      "name": "03 - Filter Opportunities by Type",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities?type=Internships",
          "host": ["{{baseUrl}}"],
          "path": ["api", "opportunities"],
          "query": [
            {
              "key": "type",
              "value": "Internships"
            }
          ]
        },
        "description": "Filters opportunities by specific category (e.g., Internships)."
      }
    },
    {
